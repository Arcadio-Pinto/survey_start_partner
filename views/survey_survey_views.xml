<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="survey_survey_view_kanban" model="ir.ui.view">
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_send_survey']" position="before">
                <button name="action_open_start_survey_wizard"
                        string="Start Survey" type="object"
                        class="btn btn-secondary text-nowrap"
                        invisible="not active"/>
            </xpath>
        </field>
    </record>
</odoo>
